# Required environment variables
# Copy this file to .env and fill in values

# GitHub token (optional but recommended for higher rate limits)
GITHUB_TOKEN=

# Reddit credentials (for PRAW — optional, falls back to RSS if not set)
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format: tool-name/version (by /u/username)
REDDIT_USER_AGENT=ai-tech-news-tracker/1.0

# YouTube Data API v3 key (optional — fallback for flaky RSS feeds)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your project
# Quota: 10,000 units/day (1 unit per channels.list, 1 unit per playlistItems.list)
YOUTUBE_API_KEY=

# OpenAI API key (for news summarization via free-tier model)
OPENAI_API_KEY=

# Notification settings
NOTIFICATION_CHANNEL=none  # telegram, discord, email, file, none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
